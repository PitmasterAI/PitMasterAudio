#version 450
// Envolvente de pico real: cuatro fases polifásicas del sobremuestreo x4.
// env[i] = max_c max_p |sum_k taps[p][k] * x[i - desp[p] + k, c]|
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer In { float x[]; };
layout(binding = 1) readonly buffer Taps { float taps[]; };
layout(binding = 2) writeonly buffer Out { float env[]; };
layout(push_constant) uniform P {
    uint frames;
    uint canales;
    uint ktaps;
    uint relleno;
    uint d0;
    uint d1;
    uint d2;
    uint d3;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.frames) return;
    uint desfases[4] = uint[](p.d0, p.d1, p.d2, p.d3);
    float mejor = 0.0;
    for (uint f = 0u; f < 4u; ++f) {
        int desp = int(desfases[f]);
        for (uint c = 0u; c < p.canales; ++c) {
            float acc = 0.0;
            for (uint k = 0u; k < p.ktaps; ++k) {
                int idx = int(i) - desp + int(k);
                if (idx < 0 || idx >= int(p.frames)) continue;
                acc += taps[f * p.ktaps + k] * x[uint(idx) * p.canales + c];
            }
            mejor = max(mejor, abs(acc));
        }
    }
    env[i] = mejor;
}
