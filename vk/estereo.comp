#version 450
// Matriz M/S: medio y lado con sus ganancias. x = (frames, 2) entrelazado.
layout(local_size_x = 128) in;
layout(binding = 0) readonly buffer In { float src[]; };
layout(binding = 1) writeonly buffer Out { float dst[]; };
layout(push_constant) uniform P { uint frames; float gm; float gl; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.frames) return;
    float izq = src[i * 2u];
    float der = src[i * 2u + 1u];
    float medio = (izq + der) * 0.5 * p.gm;
    float lado = (izq - der) * 0.5 * p.gl;
    dst[i * 2u] = medio + lado;
    dst[i * 2u + 1u] = medio - lado;
}
