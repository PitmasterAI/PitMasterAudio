#version 450
// dst[i] = src[i] * g[frame];  frame = i / canales
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer In { float src[]; };
layout(binding = 1) readonly buffer Gan { float gan[]; };
layout(binding = 2) writeonly buffer Out { float dst[]; };
layout(push_constant) uniform P { uint n; uint canales; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) dst[i] = src[i] * gan[i / p.canales];
}
